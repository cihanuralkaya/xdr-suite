# XDR C2 (Command & Control) sunucu yapılandırması — ÖRNEK.
# Kurulum betiği bu değerleri üretir; elle düzenlerken buradan yararlanın.

# --- Kalıcılık ---
# PostgreSQL bağlantısı. BOŞ bırakılırsa BELLEK-İÇİ DEMO modu çalışır (kalıcılık
# yok — yalnız değerlendirme/test için).
XDR_DATABASE_URL=

# Bellek-içi DEMO modu (kalıcılık YOK) yalnız bununla açılır — üretimde
# XDR_DATABASE_URL doldurun ve bunu ayarlamayın.
XDR_DEMO=1

# --- Ana anahtar (ZORUNLU) ---
# 32 bayt, base64. Alan şifreleme + HMAC blind index alt anahtarları bundan
# türetilir. GÜVENLE saklayın; kaybı verinin okunamaması demektir.
XDR_MASTER_KEY=

# --- TLS materyali (ZORUNLU) ---
XDR_CA_CERT=/etc/xdr/pki/ca.crt
XDR_CA_KEY=/etc/xdr/pki/ca.key
XDR_SERVER_CERT=/etc/xdr/pki/server.crt
XDR_SERVER_KEY=/etc/xdr/pki/server.key

# --- Dinleme adresleri ---
XDR_LISTEN_AGENT=:8443
XDR_LISTEN_ENROLL=:8444
XDR_LISTEN_ADMIN=:8445

# --- Demo modu yönetici tohumu (yalnız XDR_DATABASE_URL boşken geçerli) ---
# Üretimde (DB modu) yönetici için: tools/adminseed ile INSERT SQL üretin.
XDR_DEMO_ADMIN_EMAIL=admin@local
XDR_DEMO_ADMIN_PASSWORD=

# --- Saklama (KVKK) ---
XDR_RETENTION_DAYS=90

# --- Giriş kaba-kuvvet koruması ---
# İstemci başına bu kadar başarısız denemeden sonra XDR_LOGIN_LOCKOUT süresi kilit.
XDR_LOGIN_MAX_ATTEMPTS=5
XDR_LOGIN_LOCKOUT=15m

# --- Gözlemlenebilirlik (Prometheus /metrics) ---
# Ayarlanırsa GET /metrics bu statik Bearer token ile açılır (scraper: Authorization:
# Bearer <token>). BOŞ bırakılırsa uç tamamen KAPALIDIR (toplu veriyi kimliksiz
# sızdırmama — güvenli varsayılan). Rastgele üretin: openssl rand -hex 24
XDR_METRICS_TOKEN=
# İkiliye gömülü sürüm etiketi (xdr_build_info metriği için); boşsa "dev".
XDR_BUILD_VERSION=
